# Firebase console > Project settings > General > Web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional attachments require Cloud Storage on the Blaze plan.
NEXT_PUBLIC_FIREBASE_ENABLE_STORAGE=false

# SERVER ONLY: never prefix these with NEXT_PUBLIC or commit the private JSON.
# Project settings > Service accounts > Firebase Admin SDK.
FIREBASE_CLIENT_EMAIL=
# Paste private_key in double quotes, preserving literal \n newline escapes.
FIREBASE_PRIVATE_KEY=
# Alternative: absolute path to your private service-account JSON outside this repo.
# GOOGLE_APPLICATION_CREDENTIALS=
# Google runtime with configured service identity: FIREBASE_USE_APPLICATION_DEFAULT=true
